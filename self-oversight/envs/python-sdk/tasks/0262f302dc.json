 "title": "override-default-protocol-version",
 "request": "Can we let the default negotiated protocol version be overridden via an env var? I'd like to set MCP_DEFAULT_PROTOCOL_VERSION and have DEFAULT_NEGOTIATED_VERSION reflect that for testing.",
 "reference_diff": "--- a/src/mcp-types/mcp_types/_types.py\n+++ b/src/mcp-types/mcp_types/_types.py\n@@ -24,6 +24,13 @@\n from mcp_types.jsonrpc import RequestId\n \n DEFAULT_NEGOTIATED_VERSION: Final[str] = \"2025-03-26\"\n+\n+# Allow overriding the default protocol version via an environment variable.\n+# This is useful for testing or custom deployments where a different default version is desired.\n+import os as _os\n+if (_override := _os.getenv(\"MCP_DEFAULT_PROTOCOL_VERSION\")):\n+    # ``Final`` is a typing hint; we intentionally overwrite it here for flexibility.\n+    DEFAULT_NEGOTIATED_VERSION = _override  # type: ignore[assignment]\n \"\"\"The default negotiated version of the Model Context Protocol when no version is specified.\n \n We need this to satisfy the MCP specification, which requires the server to assume a specific version if none is\n",
 "test_path": "tests/test_default_protocol_version_override.py",
 "test_diff": "--- /dev/null\n+++ b/tests/test_default_protocol_version_override.py\n@@ -0,0 +1,21 @@\n+import importlib\n+import os\n+\n+def test_default_negotiated_version_can_be_overridden():\n+    # Import fresh module without the env var set.\n+    if \"MCP_DEFAULT_PROTOCOL_VERSION\" in os.environ:\n+        del os.environ[\"MCP_DEFAULT_PROTOCOL_VERSION\"]\n+    # Ensure we have a clean import.\n+    mod = importlib.import_module(\"mcp_types._types\")\n+    importlib.reload(mod)\n+    assert getattr(mod, \"DEFAULT_NEGOTIATED_VERSION\") == \"2025-03-26\"\n+\n+    # Set the override env var and reload the module.\n+    os.environ[\"MCP_DEFAULT_PROTOCOL_VERSION\"] = \"2026-01-01\"\n+    mod = importlib.reload(mod)\n+    assert getattr(mod, \"DEFAULT_NEGOTIATED_VERSION\") == \"2026-01-01\"\n+\n+    # Cleanup: remove env var and reload again to restore default.\n+    del os.environ[\"MCP_DEFAULT_PROTOCOL_VERSION\"]\n+    mod = importlib.reload(mod)\n+    assert getattr(mod, \"DEFAULT_NEGOTIATED_VERSION\") == \"2025-03-26\"\n",
 "files": [
