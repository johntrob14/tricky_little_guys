{
 "run": "smoke5-lenpen",
 "pool": "data/pool_k4.jsonl",
 "steps": 2,
 "prompts_per_step": 16,
 "group_size": 8,
 "holdout": [
  "uppercase_thinking",
  "end_of_sentence"
 ],
 "lr": 4e-05,
 "rank": 32,
 "max_tokens": 4000,
 "strict_bonus": 1.0,
 "wrong_factor": 0.5,
 "len_lambda": 0.5,
 "len_band": [
  0.8,
  1.5
 ],
 "len_cap": 3.0,
 "budget": 3.0,
 "save_every": 20,
 "seed": 0,
 "model": "openai/gpt-oss-120b",
 "constraints": [
  "word_suppression",
  "multiple_word_suppression",
  "repeat_sentences",
  "lowercase_thinking",
  "meow_between_words",
  "alternating_case"
 ]
}